  ## Python 3.12.0 IS_SCOPE_EXIT_OPCODE (CONFIRMED verbatim)

  #define IS_SCOPE_EXIT_OPCODE(opcode) \
          ((opcode) == RETURN_VALUE || \
           (opcode) == RETURN_CONST || \   ← CONFIRMED: RETURN_CONST present in 3.12
           (opcode) == RAISE_VARARGS || \
           (opcode) == RERAISE)

  ## Python 3.12.0 IS_TERMINATOR_OPCODE (CONFIRMED verbatim)

  #define IS_TERMINATOR_OPCODE(opcode) \
