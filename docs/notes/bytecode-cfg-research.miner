relevance: HIGH
title: pycore_opcode_utils.h main branch (3.14) — complete macro definitions verbatim
authors: Python core developers
year: 2026
venue: raw.githubusercontent.com/python/cpython/main/Include/internal/pycore_opcode_utils.h
quality: CODE
url: https://raw.githubusercontent.com/python/cpython/main/Include/internal/pycore_opcode_utils.h
keywords: IS_TERMINATOR_OPCODE, IS_SCOPE_EXIT_OPCODE, IS_UNCONDITIONAL_JUMP_OPCODE, IS_CONDITIONAL_JUMP_OPCODE, IS_BACKWARDS_JUMP_OPCODE, IS_RETURN_OPCODE, IS_RAISE_OPCODE, RESUME constants, CONSTANT_* enums
cites:
cited_by:
content:
  ## Complete verbatim macro definitions from main branch (Python 3.14)

  #define IS_TERMINATOR_OPCODE(opcode) \
          (OPCODE_HAS_JUMP(opcode) || IS_SCOPE_EXIT_OPCODE(opcode))

  #define IS_SCOPE_EXIT_OPCODE(opcode) \
          ((opcode) == RETURN_VALUE || \
           (opcode) == RAISE_VARARGS || \
           (opcode) == RERAISE)
  NOTE: RETURN_CONST absent in 3.14 (removed from both opcode set and this macro).

  #define IS_UNCONDITIONAL_JUMP_OPCODE(opcode) \
          ((opcode) == JUMP || \
           (opcode) == JUMP_NO_INTERRUPT || \
           (opcode) == JUMP_FORWARD || \
           (opcode) == JUMP_BACKWARD || \
           (opcode) == JUMP_BACKWARD_NO_INTERRUPT)

  #define IS_CONDITIONAL_JUMP_OPCODE(opcode) \
          ((opcode) == POP_JUMP_IF_FALSE || \
           (opcode) == POP_JUMP_IF_TRUE || \
           (opcode) == POP_JUMP_IF_NONE || \
           (opcode) == POP_JUMP_IF_NOT_NONE)

  #define IS_BACKWARDS_JUMP_OPCODE(opcode) \
          ((opcode) == JUMP_BACKWARD || \
           (opcode) == JUMP_BACKWARD_NO_INTERRUPT)

  #define IS_RETURN_OPCODE(opcode) \
          (opcode == RETURN_VALUE)

  #define IS_RAISE_OPCODE(opcode) \
          (opcode == RAISE_VARARGS || opcode == RERAISE)

  ## IS_ASSEMBLER_OPCODE (from text)
  Checks for: JUMP_FORWARD, JUMP_BACKWARD, JUMP_BACKWARD_NO_INTERRUPT
  (These are assembly-stage-only in some context? Or perhaps pseudo-instruction
   level check. Exact definition not fully extracted.)

  ## MAKE_FUNCTION flag bits

  #define MAKE_FUNCTION_DEFAULTS    0x01
  #define MAKE_FUNCTION_KWDEFAULTS  0x02
  #define MAKE_FUNCTION_ANNOTATIONS 0x04
  #define MAKE_FUNCTION_CLOSURE     0x08
  #define MAKE_FUNCTION_ANNOTATE    0x10

  ## Common constants (LOAD_COMMON_CONSTANT oparg values — Python 3.14)

  #define CONSTANT_ASSERTIONERROR    0
  #define CONSTANT_NOTIMPLEMENTEDERROR 1
  #define CONSTANT_BUILTIN_TUPLE     2
  #define CONSTANT_BUILTIN_ALL       3
  #define CONSTANT_BUILTIN_ANY       4
  #define CONSTANT_BUILTIN_LIST      5
  #define CONSTANT_BUILTIN_SET       6
  #define CONSTANT_NONE              7
  #define CONSTANT_EMPTY_STR         8
  #define CONSTANT_TRUE              9
  #define CONSTANT_FALSE             10
  #define CONSTANT_MINUS_ONE         11
  #define CONSTANT_BUILTIN_FROZENSET 12
  #define CONSTANT_EMPTY_TUPLE       13
  #define NUM_COMMON_CONSTANTS       14

  These are oparg values for LOAD_COMMON_CONSTANT opcode in 3.14.

  ## RESUME oparg constants

  #define RESUME_AT_FUNC_START      0
  #define RESUME_AFTER_YIELD        1
  #define RESUME_AFTER_YIELD_FROM   2
  #define RESUME_AFTER_AWAIT        3
  #define RESUME_AT_GEN_EXPR_START  4
  #define RESUME_OPARG_LOCATION_MASK 0x7  ← bits 2-0: context
  #define RESUME_OPARG_DEPTH1_MASK   0x8  ← bit 3: 1 if at except-depth 1 (3.13+)

  For pflow CFG: RESUME is always the first instruction; has oparg indicating context.
  In 3.13+: bit 3 set means function is at exception depth 1.
  NOT a terminator. NOT a jump target normally. Block leader by virtue of being first.

  ## Cross-version IS_SCOPE_EXIT_OPCODE summary (authoritative)

  Python 3.12 (v3.12.0):
    IS_SCOPE_EXIT_OPCODE = {RETURN_VALUE, RETURN_CONST, RAISE_VARARGS, RERAISE}

  Python 3.13:
    IS_SCOPE_EXIT_OPCODE = {RETURN_VALUE, RETURN_CONST, RAISE_VARARGS, RERAISE}
    (RETURN_CONST still present in 3.13)

  Python 3.14 (main branch):
    IS_SCOPE_EXIT_OPCODE = {RETURN_VALUE, RAISE_VARARGS, RERAISE}
    (RETURN_CONST removed)
<<<END>>>


